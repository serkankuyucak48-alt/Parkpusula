{
  "expo": {
    "name": "PARKPUSULA",
    "slug": "parkpusula",
    "scheme": "parkpusula",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2f7d6d"
    },
    "ios": {
      "bundleIdentifier": "tr.parkpusula.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Yakınındaki sokakların park durumunu göstermek ve seni boş park yerine yönlendirmek için konumunu kullanıyoruz.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "tr.parkpusula.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2f7d6d"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakınındaki sokakların park durumunu göstermek ve seni boş park yerine yönlendirmek için konumunu kullanıyoruz."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "16.4" }
        }
      ]
    ]
  }
}
